{
  "name": "deskline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small help desk on Cloudflare Workers + Neon Postgres",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261116.1": true
  }
}
